<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
      <PackageReference Include="RapidOcrNet" Version="3.0.0" />
        <!-- Neutraliza el nativo CPU que arrastra RapidOcrNet.
          ExcludeAssets="all" evita que copie su libonnxruntime.so. -->
      <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.28.0" ExcludeAssets="all" PrivateAssets="all" />

      <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.28.0" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Models\PP-OCRv6\" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Neni.Abstractions\Neni.Abstractions.csproj" />
    </ItemGroup>

</Project>
