<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Neni.Presentation.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Neni.Presentation.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Neni - VN Screen Translator">

    <!-- Sin Design.DataContext: MainViewModel ahora exige un ICoordinator por constructor
         (lo arma Composition/CoordinatorFactory en App.axaml.cs), así que no hay una instancia
         trivial para el previewer del IDE. -->

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                MinWidth="220">
        <Button Content="Load Models"
                Command="{Binding InitializeCommand}"
                HorizontalAlignment="Stretch" />
        <Button Content="Select Window"
                Command="{Binding SelectWindowCommand}"
                HorizontalAlignment="Stretch" />
        <Button Content="Draw ROIs"
                Command="{Binding DrawRoisCommand}"
                HorizontalAlignment="Stretch" />
        <Button Content="Start"
                Command="{Binding StartCycleCommand}"
                HorizontalAlignment="Stretch" />
        <Button Content="Stop"
                Command="{Binding StopCycleCommand}"
                HorizontalAlignment="Stretch" />
        <TextBlock Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center" />
        <TextBlock Text="{Binding CycleReports, StringFormat='Vueltas: {0}'}"
                   FontSize="11" Opacity="0.7"
                   HorizontalAlignment="Center" />

        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4"
                Padding="8" MinHeight="120">
            <ScrollViewer>
                <TextBlock Text="{Binding DetectedText}"
                           TextWrapping="Wrap"
                           FontFamily="monospace" />
            </ScrollViewer>
        </Border>
    </StackPanel>

</Window>
