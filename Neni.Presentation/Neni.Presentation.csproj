<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- MVVM (ViewModels/Views) solo conoce Neni.Application. Las referencias de abajo
         (Platform/Ocr/Imaging/Translation) las usa exclusivamente Composition/CoordinatorFactory,
         el composition root: es el único lugar de esta capa autorizado a ver implementaciones
         concretas, porque IOverlay vive aquí mismo y necesita juntarse con las demás para armar
         el Coordinator. -->
    <ProjectReference Include="../Neni.Application/Neni.Application.csproj" />
    <ProjectReference Include="../Neni.Platform/Neni.Platform.csproj" />
    <ProjectReference Include="../Neni.Ocr/Neni.Ocr.csproj" />
    <ProjectReference Include="../Neni.Imaging/Neni.Imaging.csproj" />
    <ProjectReference Include="../Neni.Translation/Neni.Translation.csproj" />
  </ItemGroup>
</Project>
